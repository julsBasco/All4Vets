# Protect the admin directory
# This provides an additional layer of security
# The Directory Privacy in cPanel is the PRIMARY protection

# Deny access to this .htaccess file
<Files .htaccess>
    Order Allow,Deny
    Deny from all
</Files>

# Optional: Restrict by IP (uncomment and modify as needed)
# <RequireAll>
#     Require ip 192.168.1.0/24
#     Require ip 10.0.0.0/8
# </RequireAll>

# Disable directory listing
Options -Indexes

# Prevent execution of PHP in subdirectories (security)
# php_flag engine on
